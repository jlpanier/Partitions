<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!--Palette
        Vert principal : #4CAF50
        Vert foncé : #388E3C
        Vert clair : #C8E6C9    
        Blanc cassé : #FAFAFA
        Gris texte : #333333

        🧩 Usage MAUI
        Bouton flottant : #4CAF50
        Hover / press : #388E3C
        Fond du menu : #FAFAFA
        Bordures : #C8E6C9
    
    00695C
    -->
    
    <!--background color-->
    <Color x:Key="Primary">#2E7D32</Color>
    <Color x:Key="Secondary">#66BB6A</Color>
    <Color x:Key="Background">#FAF7F2</Color>
    <Color x:Key="SecondaryBackground">#F2ECE4</Color>
    <Color x:Key="TextPrimary">#1E1E1E</Color>
    <Color x:Key="TextSecondary ">#6D6D6D</Color>
    <Color x:Key="Stroke">#D0C8C0</Color>
    <Color x:Key="Shadow">#00000020</Color>

    <Color x:Key="White">#FAFAFA</Color>
    <Color x:Key="Black">Black</Color>

    <Color x:Key="LightOnDarkBackground">#C8E6C9</Color>
    <!--Vert foncé-->
    <Color x:Key="DarkOnLightBackground">#388E3C</Color>

</ResourceDictionary>