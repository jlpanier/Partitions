<ContentPage
    x:Class="Main.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Main.ViewModels"
    xmlns:converter="clr-namespace:Main.Converter"
    Title="">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <converter:SelectedToColorConverter x:Key="SelectedToColorConverter" />
    </ContentPage.Resources>
    
    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*" BackgroundColor="{StaticResource SecondaryBackground}">
            <Label 
                Grid.Row="0" 
                Text="Partitions"
                Style="{StaticResource LabelHeader}">
            </Label>

            <!-- ===================== -->
            <!--   Zone de recherche   -->
            <!-- ===================== -->

            <Border Grid.Row="1" StrokeThickness="0"  Margin="6,24,16,12" BackgroundColor="{StaticResource SecondaryBackground}">
                <Grid ColumnDefinitions="Auto,*" BackgroundColor="{StaticResource SecondaryBackground}" >
                    <Button Grid.Column="0" Style="{StaticResource ButtonSearch}" Text="🔍" VerticalOptions="Start"/>
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto " BackgroundColor="{StaticResource SecondaryBackground}">
                        <Entry Grid.Row="0" Placeholder="Recherche" Text="{Binding SearchText}" TextColor="{StaticResource Primary}" PlaceholderColor="{StaticResource Secondary}"/>
                        <Label Grid.Row="1" Text="{Binding SearchStatusText}" HorizontalOptions="End" TextColor="{StaticResource Primary}" FontSize="12"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===================== -->
            <!--   Zone de tags        -->
            <!-- ===================== -->

            <Border BackgroundColor="{StaticResource SecondaryBackground}"
                Grid.Row="2" 
                Margin="12,0,12,0">

                <CollectionView 
                    BackgroundColor="{StaticResource SecondaryBackground}"
                    ItemsSource="{Binding Tags}"
                    SelectionMode="None"
                    HeightRequest="56"
                    >
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="2"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border 
                                Stroke="{StaticResource Primary}" 
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="48"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource SelectedToColorConverter}}"  
                                Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding BindingContext.ClickTag, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout>

                                    <Label 
                                        Text="{Binding Label}"
                                        TextColor="{Binding IsNotSelected, Converter={StaticResource SelectedToColorConverter}}"
                                        BackgroundColor="Transparent"
                                        Padding="12,6,12,6"
                                        Margin="6"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        />

                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Border>

                <!-- ======================== -->
                <!--   Liste des partitions   -->
                <!-- ======================== -->


            <Border Grid.Row="3" Style="{StaticResource BorderList}" Margin="6,24,6,12" BackgroundColor="{StaticResource SecondaryBackground}">

                <CollectionView 
                    BackgroundColor="{StaticResource Background}"
                    ItemsSource="{Binding Items}"
                    SelectionMode="None"
                    VerticalOptions="Fill"
                    ItemsUpdatingScrollMode="KeepItemsInView"
                    >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,*,Auto" Margin="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding BindingContext.ClickEdit, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <Label 
                                        Grid.Column="0"
                                        Text="{Binding Label}"
                                        Style="{StaticResource LabelItem}"
                                        TextColor="{StaticResource Primary}"
                                        HorizontalOptions="Start"
                                        >
                                    </Label>
                                    <Label 
                                        Grid.Column="1"
                                        Text="{Binding Compositor}"
                                        Style="{StaticResource LabelItem}"
                                        TextColor="{StaticResource Primary}"
                                        HorizontalOptions="Start"
                                        >
                                    </Label>
                                    <Label 
                                        Grid.Column="4"
                                        Text="{Binding Duration}"
                                        Style="{StaticResource LabelItem}"
                                        TextColor="{StaticResource Primary}"
                                        HorizontalOptions="Start"
                                        >
                                    </Label>
                                </Grid>

                                <BoxView HeightRequest="1" Style="{StaticResource BoxViewLine}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Border>
        </Grid>
        
        <!-- ================= -->
        <!--   BOUTON FIXE     -->
        <!-- ================= -->

        <Border
            Background="Transparent"
            StrokeThickness="0"
            Stroke="Transparent"
            Padding="6"
            VerticalOptions="End"
            HorizontalOptions="Start"
            Margin="15,0,0,65"
            IsVisible="{Binding MenuVisible}">

            <VerticalStackLayout Spacing="6" BackgroundColor="white">

                <Button Text="🏷️ Tags" Command="{Binding ClickTags}" Style="{StaticResource ButtonMenu}" />
                <Button Text="📥 Import" Command="{Binding ClickImport}" Style="{StaticResource ButtonMenu}" />
                <Button Text="⚙️ Configuration" Command="{Binding ClickSettings}" Style="{StaticResource ButtonMenu}" />

            </VerticalStackLayout>
        </Border>
        <Button
            HeightRequest="48"
            WidthRequest="48"
            CornerRadius="24"
            BorderColor="{StaticResource Stroke}"
            BackgroundColor="{StaticResource Background}"
            BorderWidth="1"
            Text="☷"
            TextColor="{StaticResource Primary}"
            VerticalOptions="End"
            HorizontalOptions="Start"
            Margin="20"
            Padding="0"
            Command="{Binding ClicMenu}" />
    </Grid>

</ContentPage>
