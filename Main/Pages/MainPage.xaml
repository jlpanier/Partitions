<ContentPage
    x:Class="Main.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Main.ViewModels"
    xmlns:converter="clr-namespace:Main.Converter"
    Title="">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <converter:SelectedToColorConverter x:Key="SelectedToColorConverter" />
    </ContentPage.Resources>
    
    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <Label 
            Grid.Row="0" 
            Text="Partitions"
            Style="{StaticResource LabelHeader}">
            </Label>

            <!-- ===================== -->
            <!--   Zone de recherche   -->
            <!-- ===================== -->

            <Border Grid.Row="1" StrokeThickness="0"  Margin="6,24,16,12">
                <Grid ColumnDefinitions="Auto,*" >
                    <Button Grid.Column="0" Style="{StaticResource ButtonSearch}" Text="🔍" VerticalOptions="Start"/>
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto " >
                        <Entry Grid.Row="0" Placeholder="Recherche" Text="{Binding SearchText}" />
                        <Label Grid.Row="1" Text="{Binding SearchStatusText}" HorizontalOptions="End" TextColor="{StaticResource Primary}" FontSize="12"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===================== -->
            <!--   Zone de tags        -->
            <!-- ===================== -->

            <Border 
                Grid.Row="2" 
                Margin="12,0,12,0">

                <CollectionView 
                    BackgroundColor="{StaticResource Background}"
                    ItemsSource="{Binding Tags}"
                    SelectionMode="None"
                    >
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="2"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border 
                                Stroke="{StaticResource Primary}" 
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="36"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource SelectedToColorConverter}}"  
                                Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                                Command="{Binding BindingContext.ClickTag, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout>

                                    <Label 
                                        Text="{Binding Label}"
                                        TextColor="{Binding IsNotSelected, Converter={StaticResource SelectedToColorConverter}}"
                                        BackgroundColor="Transparent"
                                        Padding="12,6,12,6"
                                        Margin="6"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        />

                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Border>

            <ScrollView Grid.Row="3">
                <!-- ======================== -->
                <!--   Liste des partitions   -->
                <!-- ======================== -->


                <Border Style="{StaticResource BorderList}" Margin="6,24,6,12">

                    <CollectionView 
                        BackgroundColor="{StaticResource Background}"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        VerticalOptions="Fill"
                        >
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="*,*,*,Auto" Margin="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding BindingContext.ClickEdit, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Label 
                                            Grid.Column="0"
                                            Text="{Binding Label}"
                                            Style="{StaticResource LabelItem}"
                                            HorizontalOptions="Start"
                                            >
                                        </Label>
                                        <Label 
                                            Grid.Column="1"
                                            Text="{Binding Compositor}"
                                            Style="{StaticResource LabelItem}"
                                            HorizontalOptions="Start"
                                            >
                                        </Label>
                                        <Label 
                                            Grid.Column="2"
                                            Text="{Binding Arranger}"
                                            Style="{StaticResource LabelItem}"
                                            HorizontalOptions="Start"
                                            >
                                        </Label>
                                        <Label 
                                            Grid.Column="3"
                                            Text="{Binding Duration}"
                                            Style="{StaticResource LabelItem}"
                                            HorizontalOptions="Start"
                                            >
                                        </Label>
                                    </Grid>

                                    <BoxView HeightRequest="1" Style="{StaticResource BoxViewLine}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Border>
            </ScrollView>
        </Grid>
        
        <!-- ================= -->
        <!--   BOUTON FIXE     -->
        <!-- ================= -->

        <Border
            Background="Transparent"
            StrokeThickness="0"
            Stroke="Transparent"
            Padding="6"
            VerticalOptions="End"
            HorizontalOptions="Start"
            Margin="15,0,0,65"
            IsVisible="{Binding MenuVisible}">

            <VerticalStackLayout Spacing="6" BackgroundColor="white">

                <Button Text="🏷️ Tags" Command="{Binding ClickTags}" Style="{StaticResource ButtonMenu}" />
                <Button Text="📥 Import" Command="{Binding ClickImport}" Style="{StaticResource ButtonMenu}" />
                <Button Text="⚙️ Configuration" Command="{Binding ClickSettings}" Style="{StaticResource ButtonMenu}" />

            </VerticalStackLayout>
        </Border>
        <Button
            Style="{StaticResource ButtonValidationSmall}"
            HeightRequest="36"
            WidthRequest="36"
            CornerRadius="18"
            Background="{StaticResource SecondaryBackground}"
            BorderWidth="1"
            Text="☷"
            TextColor="{StaticResource Primary}"
            BorderColor="{StaticResource Stroke}"
            VerticalOptions="End"
            HorizontalOptions="Start"
            Margin="20"
            Padding="0"
            Command="{Binding ClicMenu}" />
    </Grid>

</ContentPage>
