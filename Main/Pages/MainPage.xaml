<ContentPage
    x:Class="Main.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Main.ViewModels"
    Title="">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <Grid>

        <ScrollView >
            <Grid RowDefinitions="Auto,*" >
                <Label 
                    Grid.Column="0" 
                    Text="Partitions"
                    Style="{StaticResource LabelHeader}">
                </Label>
  
                <Border Grid.Row="1" Style="{StaticResource BorderList}" Margin="6,24,6,12" StrokeShape="RoundRectangle 12">

                    <CollectionView 
                        BackgroundColor="{StaticResource Background}"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        VerticalOptions="Fill"
                        >
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="0">
                                    <Grid RowDefinitions="Auto,Auto" Margin="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding BindingContext.ClickEdit, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Label 
                                            Grid.Row="0"
                                            Text="{Binding Label}"
                                            FontSize="12"
                                            TextColor="{StaticResource Primary}"
                                            Padding="6,0,6,0"
                                            HorizontalOptions="End"
                                            VerticalTextAlignment="Center">
                                        </Label>
                                        <HorizontalStackLayout Grid.Row="1">
                                            <Label 
                                                 Text="{Binding Compositor}"
                                                 FontSize="12"
                                                 TextColor="{StaticResource Primary}"
                                                 Padding="6,0,6,6"
                                                 HorizontalOptions="End"
                                                 VerticalTextAlignment="Center">
                                            </Label>
                                            <Label 
                                                 Text="{Binding Arranger}"
                                                 FontSize="12"
                                                 TextColor="{StaticResource Primary}"
                                                 Padding="6,0,6,0"
                                                 HorizontalOptions="End"
                                                 VerticalTextAlignment="Center">
                                            </Label>

                                            <Label 
                                                 Text="{Binding Duration}"
                                                 FontSize="12"
                                                 TextColor="{StaticResource Primary}"
                                                 Padding="6,0,6,0"
                                                 HorizontalOptions="End"
                                                 VerticalTextAlignment="Center">
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <BoxView HeightRequest="1" Style="{StaticResource BoxViewLine}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Border>
            </Grid>
        </ScrollView>

        <!-- ================= -->
        <!--   BOUTON FIXE     -->
        <!-- ================= -->

        <Border
            Background="Transparent"
            StrokeThickness="0"
            Stroke="Transparent"
            Padding="6"
            VerticalOptions="End"
            HorizontalOptions="Start"
            Margin="15,0,0,65"
            IsVisible="{Binding MenuVisible}">

            <VerticalStackLayout Spacing="6" BackgroundColor="white">

                <Button Text="📥 Import" Command="{Binding ClickImport}" Style="{StaticResource ButtonMenu}"/>
                <Button Text="⚙️ Configuration" Command="{Binding ClickSettings}" Style="{StaticResource ButtonMenu}" />

            </VerticalStackLayout>
        </Border>


        <Button
            Style="{StaticResource ButtonValidationSmall}"
            HeightRequest="36"
            WidthRequest="36"
            CornerRadius="18"
            Background="{StaticResource SecondaryBackground}"
            BorderWidth="1"
            Text="☷"
            TextColor="{StaticResource Primary}"
            BorderColor="{StaticResource Stroke}"
            VerticalOptions="End"
            HorizontalOptions="Start"
            Margin="20"
            Padding="0"
            Command="{Binding ClicMenu}" />
    </Grid>

</ContentPage>
