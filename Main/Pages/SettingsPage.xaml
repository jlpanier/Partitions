<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Main.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Main.ViewModels"
    xmlns:templates="clr-namespace:Main.Templates"
    xmlns:selectors="clr-namespace:Main.Templates"
    xmlns:customs="clr-namespace:Main.Customs"
    BackgroundColor="AliceBlue"
    Title="Configuration">

    <ContentPage.BindingContext>
        <vm:SettingsViewModel />
    </ContentPage.BindingContext>

    <ScrollView Margin="10" BackgroundColor="AliceBlue">
        <Grid BackgroundColor="AliceBlue" RowDefinitions="Auto, Auto, Auto, Auto, Auto">

            <Label 
                Grid.Row="0" 
                Text="{Binding Titel}"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#333"
                />
            <Label 
                Grid.Row="1" 
                Text="{Binding SubTitel}"
                FontSize="14"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#333"
                />

            <Border Grid.Row="2" Margin="0" Padding="12" Background="White">

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding Items}"
                    SelectionMode="None"
                    Margin="20,0,20,0">

                    <CollectionView.Header>
                        <Grid ColumnDefinitions="*,*,3*">
                            <Label Grid.Column="0" FontSize="12" Text="Clef" FontAttributes="Bold" HorizontalOptions="Start"/>
                            <Label Grid.Column="1" FontSize="12" Text="Valeur"  FontAttributes="Bold" HorizontalOptions="Start"/>
                            <Label Grid.Column="2" FontSize="12" Text="Description"  FontAttributes="Bold" HorizontalOptions="Start"/>
                        </Grid>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="0">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        NumberOfTapsRequired="1"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=ClickUpdateCommand}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Grid ColumnDefinitions="*,*,3*" Margin="12">
                                    <Label Grid.Column="0" Text="{Binding Key}" FontAttributes="Bold" FontSize="12" HorizontalOptions="Start" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Val}" FontSize="12" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Text="{Binding Desc}" FontSize="12" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#DADADA" Margin="0,4,0,4" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </Border>

            <Grid   Grid.Row="3" ColumnDefinitions="*,*" Margin="0,24,0,24" >

                <Button Grid.Column="0"
                    Margin="0,0,12,0"
                    Text="Add"
                    CornerRadius="12"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    Command="{Binding ClickAddCommandd}" />

                <Button Text="Annuler" Grid.Column="1"
                    Margin="12,0,12,0"
                    CornerRadius="12"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    Command="{Binding ClickCancelCommand}" />

            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>