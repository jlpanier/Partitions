<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Main.ViewModels"
    x:Class="Main.Pages.TagsPage"
    Title="">

    <ContentPage.BindingContext>
        <vm:TagsViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <ScrollView >
            <Grid RowDefinitions="Auto,*,Auto">
                <Label 
                    Grid.Row="0" 
                    Text="Tags"
                    Style="{StaticResource LabelHeader}"
                    HorizontalOptions="Center"
                    VerticalTextAlignment="Center"/>

                <Border Grid.Row="1" Style="{StaticResource BorderList}" Margin="6" StrokeShape="RoundRectangle 12">

                    <CollectionView 
                        BackgroundColor="White"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        VerticalOptions="Fill"
                        >
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TagsViewModel}}, Path=ClickEdit}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Label Grid.Column="0" Style="{StaticResource LabelItem}" Text="{Binding Label}" />
                                        <Label Grid.Column="1" Style="{StaticResource LabelItem}" Text="{Binding Supplier}" />
                                    </Grid>

                                    <BoxView HeightRequest="1" Style="{StaticResource BoxViewLine}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>


            </Grid>
        </ScrollView>
        <Button 
            VerticalOptions="End"
            HorizontalOptions="End"
            Margin="20"
            WidthRequest="48"
            HeightRequest="48"
            ImageSource="{StaticResource IconAdd}"
            Style="{StaticResource ButtonFloatingOk}"
            Command="{Binding ClickAdd}" />
    </Grid>

</ContentPage>
    