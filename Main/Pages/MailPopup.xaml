<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Main.Pages.MailPopup">

    <VerticalStackLayout
        Padding="12"
        Spacing="12"
        WidthRequest="360">

        <Label Style="{StaticResource LabelHeader}" Text="Nom" HorizontalOptions="Center" />

        <Entry x:Name="NameEntry" Placeholder="Nom" Text="{Binding Name}" Style="{StaticResource EntryPrimary}" />

        <Label Style="{StaticResource LabelHeader}" Text="Mail" HorizontalOptions="Center" />

        <Entry x:Name="MailEntry" Placeholder="Mail" Text="{Binding Email}"  Style="{StaticResource EntryPrimary}" />

        <Grid Style="{StaticResource GridValidation}">
            <Border Style="{StaticResource BorderValidation}">
                <HorizontalStackLayout Padding="12,3,12,3" Margin="1" Spacing="24">
                    <Button 
                        Style="{StaticResource ButtonValidationSmall}"
                        Clicked="OnSave" />

                    <Button 
                        Style="{StaticResource ButtonAnnulerLarge}"
                        BackgroundColor="{StaticResource SecondaryBackground}"
                        Clicked="OnCancel"/>

                </HorizontalStackLayout>
            </Border>
        </Grid>

    </VerticalStackLayout>
</toolkit:Popup>
