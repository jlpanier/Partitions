<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Main.Pages.FileActionPopup">

    <VerticalStackLayout
        Padding="20"
        Spacing="15"
        WidthRequest="300">

        <Label Style="{StaticResource LabelHeader}" Text="Fichier" HorizontalOptions="Center" />

        <Entry x:Name="NameEntry" Placeholder="Nouveau nom" Text="{Binding FileName}" Style="{StaticResource EntryPrimary}" />

        <Grid Style="{StaticResource GridValidation}">
            <Border Style="{StaticResource BorderValidation}">
                <HorizontalStackLayout Padding="12,3,12,3" Margin="1" Spacing="24">
                    <Button 
                        Style="{StaticResource ButtonValidationSmall}"
                        Clicked="OnSave" />

                    <Button 
                        Style="{StaticResource ButtonAnnulerLarge}"
                        BackgroundColor="{StaticResource SecondaryBackground}"
                        Clicked="OnCancel"/>

                    <Button 
                        Style="{StaticResource ButtonDeleteSmall}"
                        Clicked="OnDelete" />

                    <Button 
                        Style="{StaticResource ButtonDeleteSmall}"
                        Text="🗄️"
                        Clicked="OnArchive" />

                </HorizontalStackLayout>
            </Border>
        </Grid>

    </VerticalStackLayout>
</toolkit:Popup>
