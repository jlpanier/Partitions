<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Main.ViewModels"
    xmlns:converter="clr-namespace:Main.Converter"
    x:Class="Main.Pages.EditPartitionPage"
    Title="{Binding Header}">
    <ContentPage.BindingContext>
        <vm:EditPartitionViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <converter:SelectedToColorConverter x:Key="SelectedToColorConverter" />
    </ContentPage.Resources>
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Border Style="{StaticResource BorderEdit}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nom" Style="{StaticResource LabelEdit}" />
                    <Entry Placeholder="Key" Text="{Binding Name, Mode=TwoWay}" TextColor="{StaticResource Primary}" PlaceholderColor="{StaticResource Secondary}" />
                </VerticalStackLayout>
            </Border>
            
            <Border Style="{StaticResource BorderEdit}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Compositeur" Style="{StaticResource LabelEdit}" />
                    <Entry Placeholder="Compositeur" Text="{Binding Compositor, Mode=TwoWay}" TextColor="{StaticResource Primary}" PlaceholderColor="{StaticResource Secondary}"  />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource BorderEdit}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Arrangeur" Style="{StaticResource LabelEdit}" />
                    <Entry Placeholder="Arrangeur" Text="{Binding Arranger, Mode=TwoWay}" VerticalOptions="Center"  TextColor="{StaticResource Primary}" PlaceholderColor="{StaticResource Secondary}"  />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource BorderEdit}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Durée" Style="{StaticResource LabelEdit}" />
                    <HorizontalStackLayout Spacing="0">

                        <Picker Title="" TextColor="{StaticResource Primary}" 
                            ItemsSource="{Binding MinutesList}"
                            SelectedItem="{Binding SelectedMinutes}" />

                        <Label Text="mn" Style="{StaticResource LabelItem}" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />

                        <Picker Title="" TextColor="{StaticResource Primary}" 
                            ItemsSource="{Binding SecondsList}"
                            SelectedItem="{Binding SelectedSeconds}" />

                        <Label Text="sec" Style="{StaticResource LabelItem}" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />

                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ===================== -->
            <!--   Zone de tags        -->
            <!-- ===================== -->

            <Border Margin="0" Padding="12" Background="{StaticResource SecondaryBackground}" StrokeShape="RoundRectangle 18">
                <CollectionView 
                    BackgroundColor="{StaticResource SecondaryBackground}"
                    ItemsSource="{Binding Tags}"
                    SelectionMode="None"
                    HeightRequest="56"
                    >
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="2"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border 
                                Stroke="{StaticResource Primary}" 
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="48"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource SelectedToColorConverter}}"  
                                Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                                Command="{Binding BindingContext.ClickTag, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout>

                                    <Label 
                                        Text="{Binding Label}"
                                        TextColor="{Binding IsNotSelected, Converter={StaticResource SelectedToColorConverter}}"
                                        BackgroundColor="Transparent"
                                        Padding="12,6,12,6"
                                        Margin="6"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        />

                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource BorderList}" Margin="6,24,6,12" StrokeShape="RoundRectangle 12">

                <CollectionView 
                        BackgroundColor="{StaticResource Background}"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        VerticalOptions="Fill"
                        >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="Auto, *" Margin="12">
                                        <Label Grid.Column="0"
                                            Text="{Binding Unicode}"
                                            FontSize="24"
                                            TextColor="{StaticResource Primary}"
                                            Padding="6,0,6,0"
                                            HorizontalOptions="Start"
                                            VerticalTextAlignment="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer 
                                                    Command="{Binding BindingContext.ClickView, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label 
                                            Grid.Column="1"
                                            Text="{Binding FileName}"
                                            FontSize="12"
                                            TextColor="{StaticResource Primary}"
                                            Padding="6,0,6,0"
                                            HorizontalOptions="Start"
                                            VerticalTextAlignment="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer 
                                                    Command="{Binding BindingContext.ClickEdit, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>

                                    <BoxView HeightRequest="1" Style="{StaticResource BoxViewLine}" />
                                </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Border>
            <Grid ColumnDefinitions="*,Auto">

                <Label
                    Text="🗄️ Afficher les archives"
                    Style="{StaticResource LabelEdit}"
                    VerticalOptions="Center"
                    HorizontalOptions="End"/>
                <Switch
                    Grid.Column="1"
                    IsToggled="{Binding ShowArchivedFiles}" />
            </Grid>

            <Grid Style="{StaticResource GridValidation}">
                <Border Style="{StaticResource BorderValidation}">
                    <HorizontalStackLayout Padding="12,3,12,3" Margin="1" Spacing="24">
                        <Button 
                            Style="{StaticResource ButtonValidationSmall}"
                            Command="{Binding ClickSave}" />

                        <Button 
                            Style="{StaticResource ButtonAnnulerLarge}"
                            BackgroundColor="{StaticResource SecondaryBackground}"
                            Command="{Binding ClickCancel}" />

                        <Button 
                            Style="{StaticResource ButtonDeleteSmall}"
                            Command="{Binding ClickDelete}" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
            
        </VerticalStackLayout>
    </ScrollView>


</ContentPage>